{
  "name": "promptcraft",
  "version": "1.2.0",
  "description": "Pure TypeScript cinematic promptcraft engine and AI agent CLI",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "promptcraft": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test engine/src",
    "build": "bun run build:cli && bun run build:bundle",
    "build:cli": "bun build engine/src/cli.ts --compile --target=bun-linux-x64 --outfile bin/promptcraft",
    "build:bundle": "bun build engine/src/cli.ts --target=node --outfile dist/cli.js",
    "prepack": "bun run build:bundle",
    "typecheck": "bun x tsc --noEmit --project engine/tsconfig.json",
    "verify:builds": "node engine/scripts/verify-builds.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
